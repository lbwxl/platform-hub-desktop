{
  "name": "doudian-platform-hub",
  "version": "0.1.4",
  "private": true,
  "description": "基于 CDP 的多平台电商工作台，首期支持抖店并兼容可导入的闲鱼 Hook 包",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "pnpm build:hooks",
    "dev": "node scripts/dev.mjs",
    "build:hook": "pnpm build:hooks",
    "build:hooks": "pnpm --dir packages/doudian-hook build && pnpm --dir packages/kuaishou-hook build",
    "pretest": "pnpm build:hooks",
    "pretypecheck": "pnpm build:hooks",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@platform-hub/doudian-hook": "workspace:*",
    "@platform-hub/kuaishou-hook": "workspace:*",
    "lucide-vue-next": "^0.541.0",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "37.3.1",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
