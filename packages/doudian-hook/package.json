{
  "name": "@platform-hub/doudian-hook",
  "version": "0.3.0",
  "description": "抖店 CDP window runtime Hook，提供会话、消息、订单同步、回复、图片和商品能力",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./runtime": "./dist/runtime.js",
    "./runtime.js": "./dist/runtime.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "API.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "pnpm build && pnpm pack --pack-destination ../../artifacts"
  },
  "keywords": [
    "doudian",
    "electron",
    "cdp",
    "hook"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
